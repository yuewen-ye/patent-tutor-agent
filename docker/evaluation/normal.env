# 基线：真实向量检索 + rerank + Expert A/B 辩论
RAG_RETRIEVAL_MODE=real
RAG_REAL_FALLBACK_TO_MOCK=false
RAG_RERANK_ENABLED=true
PATENT_TUTOR_RAG_TOOL_ENABLED=true
PATENT_TUTOR_DEBATE_ENABLED=true

# 每个实验必须使用互不重叠的宿主目录和 learner 前缀。
EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/normal/system
EVAL_RESULT_DIR=./artifacts/evaluation/normal/results
EVAL_LEARNER_PREFIX=eval-normal

# 画像编号，而不是 profile ID；与脚本 --profiles 语义一致。
EVAL_PROFILES=1-2-3
EVAL_TARGET_ROUND=3
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
