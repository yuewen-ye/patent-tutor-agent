LLM_TIMEOUT_SECONDS=90
LLM_RETRY_TIMES=3

AGENT_CONFIG_PATH=config/agents.yaml

# ── 数据库连接（本机直连，非 Docker 时必填）──
# Docker 部署时 compose 会自动覆盖 PATENT_TUTOR_MYSQL_URL 指向容器内 mysql 服务，
# 本机直接运行（uv run python backend/main.py）时必须自行配置：
#   mysql://用户名:密码@主机:端口/数据库名
# 若连 Docker 的 MySQL，主机用 127.0.0.1（需先在 compose 的 mysql 服务加 ports: - "3306:3306"），
# 用户名/密码用容器初始化时的 MYSQL_USER/MYSQL_PASSWORD（默认 patent_tutor / patent_tutor_pw）
PATENT_TUTOR_MYSQL_URL=mysql://patent_tutor:patent_tutor_pw@127.0.0.1:3306/patent_tutor
PATENT_TUTOR_MYSQL_POOL_SIZE=5
PATENT_TUTOR_MYSQL_CONNECT_TIMEOUT=5
PATENT_TUTOR_MYSQL_AUTO_MIGRATE=true
# 产物与日志目录（本机运行时用相对路径；Docker 部署由 compose 覆盖为 /app/artifacts）
ARTIFACT_ROOT=artifacts
WORKFLOW_LOG_ROOT=artifacts
# 本机开发环境标记；Docker 部署由 compose 覆盖为 production
PATENT_TUTOR_ENV=development

# ── Docker 部署改密码（可选）──
# 不设则 compose 使用默认值 patent_tutor_pw；如要修改，两个变量改成相同的强密码
# （compose 会用它们初始化 MySQL 并拼出后端连接串）
MYSQL_PASSWORD=patent_tutor_pw
MYSQL_ROOT_PASSWORD=patent_tutor_pw

# RAG defaults to real Milvus Lite + BGE-M3 retrieval.
# Set RAG_RETRIEVAL_MODE=mock only when you intentionally need fixed demo chunks.
RAG_RETRIEVAL_MODE=real

# Optional complete local BGE-M3 model directory. When set, RAG does not download from the network.
RAG_EMBEDDING_MODEL_PATH=
