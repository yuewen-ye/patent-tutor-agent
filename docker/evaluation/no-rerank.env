# 保留真实向量检索和 Expert 检索工具，但跳过 CrossEncoder rerank。
RAG_RETRIEVAL_MODE=real
RAG_REAL_FALLBACK_TO_MOCK=false
RAG_RERANK_ENABLED=false
PATENT_TUTOR_RAG_TOOL_ENABLED=true
PATENT_TUTOR_DEBATE_ENABLED=true
# 评测不生成结构化课件、音频或 PPT/PPTX，缩短每轮时间。
PATENT_TUTOR_SLIDE_DECK_ENABLED=false
PATENT_TUTOR_PPTX_ENABLED=false

EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/no-rerank/system
EVAL_RESULT_DIR=./artifacts/evaluation/no-rerank/results
EVAL_LEARNER_PREFIX=eval-no-rerank
EVAL_PROFILES=6-9-10-13-15
EVAL_TARGET_ROUND=3
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
