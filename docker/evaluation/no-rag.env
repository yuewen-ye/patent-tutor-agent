# 关闭所有检索：chat 路径和 Expert 工具均不读取 RAG。
RAG_RETRIEVAL_MODE=off
RAG_REAL_FALLBACK_TO_MOCK=false
RAG_RERANK_ENABLED=false
PATENT_TUTOR_RAG_TOOL_ENABLED=false
PATENT_TUTOR_DEBATE_ENABLED=true
# 评测不生成结构化课件、音频或 PPT/PPTX，缩短每轮时间。
PATENT_TUTOR_SLIDE_DECK_ENABLED=false
PATENT_TUTOR_PPTX_ENABLED=false

EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/no-rag/system
EVAL_RESULT_DIR=./artifacts/evaluation/no-rag/results
EVAL_LEARNER_PREFIX=eval-no-rag
EVAL_PROFILES=1-2-3
EVAL_TARGET_ROUND=3
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
