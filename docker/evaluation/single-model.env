# 单模型对照组：Expert A、Expert B、Judge 均强制使用同一 provider/model。
# 当前选用 greatrouter-gpt3 → gpt-5.6-terra。环境 provider override 会同时禁用
# agents.yaml 为三个节点定义的异构 model 与 fallback，避免发生跨模型降级。
EXPERT_A_PROVIDER=greatrouter-gpt3
EXPERT_B_PROVIDER=greatrouter-gpt3
JUDGE_PROVIDER=greatrouter-gpt3

# 保持完整教学工作流和真实检索；所有 PPT/结构化课件节点均关闭。
RAG_RETRIEVAL_MODE=real
RAG_REAL_FALLBACK_TO_MOCK=false
RAG_RERANK_ENABLED=true
PATENT_TUTOR_RAG_TOOL_ENABLED=true
PATENT_TUTOR_DEBATE_ENABLED=true
PATENT_TUTOR_SLIDE_DECK_ENABLED=false
PATENT_TUTOR_PPTX_ENABLED=false

EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/single-model/system
EVAL_RESULT_DIR=./artifacts/evaluation/single-model/results
EVAL_LEARNER_PREFIX=eval-single-model
EVAL_PROFILES=1-2-3
EVAL_TARGET_ROUND=3
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
