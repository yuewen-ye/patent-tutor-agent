# 保留真实 RAG + rerank，仅关闭 Expert A/B 的交叉审查和修订阶段。
RAG_RETRIEVAL_MODE=real
RAG_REAL_FALLBACK_TO_MOCK=false
RAG_RERANK_ENABLED=true
PATENT_TUTOR_RAG_TOOL_ENABLED=true
PATENT_TUTOR_DEBATE_ENABLED=false

EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/no-debate/system
EVAL_RESULT_DIR=./artifacts/evaluation/no-debate/results
EVAL_LEARNER_PREFIX=eval-no-debate
EVAL_PROFILES=1-2-3
EVAL_TARGET_ROUND=3
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
