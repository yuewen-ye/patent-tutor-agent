# 无辩论对照组：真实检索 + rerank + Expert 检索工具，但关闭 Expert A/B 辩论（单专家模式）
RAG_RETRIEVAL_MODE=real
RAG_RERANK_ENABLED=true
PATENT_TUTOR_RAG_TOOL_ENABLED=true
PATENT_TUTOR_DEBATE_ENABLED=false
# 评测不生成结构化课件、音频或 PPT/PPTX，缩短每轮时间。
PATENT_TUTOR_SLIDE_DECK_ENABLED=false
PATENT_TUTOR_PPTX_ENABLED=false

# 每个实验必须使用互不重叠的宿主目录和 learner 前缀。
# 现有运行数据位于 artifacts/evaluation/evaluation/ 子目录（8/30 整理时移入）。
EVAL_BACKEND_ARTIFACT_DIR=./artifacts/evaluation/evaluation/no-debate/system
EVAL_RESULT_DIR=./artifacts/evaluation/evaluation/no-debate/results
EVAL_LEARNER_PREFIX=eval-no-debate

# 画像编号，而不是 profile ID；与脚本 --profiles 语义一致。
EVAL_PROFILES=6-9-10
EVAL_TARGET_ROUND=5
EVAL_MODELS_VOLUME=patent-tutor-evaluation-models
